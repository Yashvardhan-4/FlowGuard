# FlowGuard Configuration

# Server configuration
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# AWS Bedrock Configuration
# Set AWS credentials for real Bedrock model invocation.
# If AWS credentials are empty or BEDROCK_MOCK=true, FlowGuard uses the deterministic local Bedrock arbitrator.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MOCK=false

# Simulation Settings
SIMULATE_RING_DEVICE=true
SIMULATE_ALEXA_SPEAKER=true
