{
  "name": "flowguard",
  "version": "1.0.0",
  "description": "Alexa+ deep-work interruption arbitration agent backend with MCP and AWS Bedrock",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build:server": "tsc",
    "build:ui": "vite build",
    "build": "npm run build:server && npm run build:ui",
    "dev:server": "tsx watch src/server.ts",
    "dev:ui": "vite",
    "start": "tsx src/server.ts",
    "demo": "tsx src/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "alexa",
    "mcp",
    "bedrock",
    "deep-work",
    "flowguard",
    "ring"
  ],
  "author": "FlowGuard Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
